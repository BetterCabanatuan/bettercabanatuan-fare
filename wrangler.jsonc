// Cloudflare Workers config for the OpenNext build. Setup: docs/deploy/cloudflare.md
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bettercabanatuan-fare",
  // Both paths are written by `opennextjs-cloudflare build`; don't change them.
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    // Node.js APIs for Next.js.
    "nodejs_compat",
    // fetch() may only reach public addresses (Supabase, OSRM).
    "global_fetch_strictly_public",
  ],

  // Public settings, safe to commit. Next.js inlines NEXT_PUBLIC_* at build time, so the
  // same three must also be build variables (Workers Builds → Variables and secrets);
  // these runtime copies cover server code that reads them when the build didn't have them.
  // Every `wrangler deploy` replaces the Worker's plain-text variables with this list.
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://pamasahe.bettercabanatuan.org",
    "NEXT_PUBLIC_SUPABASE_URL": "https://atbnaxugjobwqtaombtx.supabase.co",
    // Public by design: row level security keeps every table closed to it.
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_QWp6HUsgalwjwxuxlC2mGQ_-eDT35Ac",
    // "true" serves the maintenance page (HTTP 503) on every page except /admin; read at
    // request time, so no rebuild. A dashboard change lasts only until the next deploy
    // resets it to this value. How to switch: docs/deploy/cloudflare.md#maintenance-mode
    "MAINTENANCE_MODE": "false",
    // Optional end time shown as "Back by …", e.g. "2026-10-18T18:00+08:00"; empty for unknown.
    "MAINTENANCE_UNTIL": "",
  },
  // Secrets, set once with `npx wrangler secret put <NAME>` (or as type "Secret" in the
  // dashboard) and never committed. Unlike "vars", deploys leave them in place:
  //   SUPABASE_SECRET_KEY  server-only Supabase key; bypasses row level security
  //   ADMIN_EMAILS         comma-separated admin addresses (a secret to keep them out of git)

  "observability": {
    "enabled": true,
  },
}
