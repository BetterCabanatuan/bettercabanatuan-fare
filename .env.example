# Postgres on Supabase, through the Session pooler (Supavisor, port 5432). It is reachable
# over IPv4 and supports prepared statements and migrations, so `prisma migrate deploy` and
# the app share this one string. Copy it from the Supabase dashboard: your project → Connect
# → Session pooler. Copy the host as shown; it can't be guessed from the region.
# URL-encode the password if it has reserved characters (& # ? / @ : or a space).
# For local development you can point this at a local Postgres instead (see docs/deploy/supabase.md).
DATABASE_URL="postgresql://postgres.[FILL: SUPABASE_PROJECT_REF]:[FILL: SUPABASE_DB_PASSWORD]@[FILL: SUPABASE_POOLER_HOST]:5432/postgres"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated. Only these addresses can request a sign-in link or open /admin.
ADMIN_EMAILS="admin@example.com,another.admin@example.com"

# Magic-link email. Without RESEND_API_KEY the link is printed to the server console
# (development only; production refuses to start a sign-in without it).
RESEND_API_KEY=""
EMAIL_FROM="Pamasahe Cabanatuan <no-reply@example.com>"

# Public address of the site, with https. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_SITE_URL="https://pamasahe.example.com"
