# Postgres connection string (Neon, Supabase, Vercel Postgres, or local).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pamasahe"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated. Only these addresses can request a sign-in link or open /admin.
ADMIN_EMAILS="admin@example.com,another.admin@example.com"

# Magic-link email. Without RESEND_API_KEY the link is printed to the server console
# (development only; production refuses to start a sign-in without it).
RESEND_API_KEY=""
EMAIL_FROM="Pamasahe Cabanatuan <no-reply@example.com>"

# ── Docker / VPS (docker-compose.yml) ────────────────────────────────────────
# Compose builds DATABASE_URL and BETTER_AUTH_URL from these, so the two above are
# only for running the app outside Docker.

# Public address of the site, with https. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_SITE_URL="https://pamasahe.example.com"

# Password for the bundled Postgres. It goes into a connection URL, so use letters and
# digits only: openssl rand -hex 24
POSTGRES_PASSWORD=""

# Host port the app listens on (127.0.0.1 only; your reverse proxy forwards to it).
APP_PORT=3000
