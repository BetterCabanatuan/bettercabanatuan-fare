# Copy to .env and fill in each [FILL: ...]. Production values go in Cloudflare and
# GitHub instead (see docs/deploy/cloudflare.md).

# ── 1. Supabase ──────────────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API Keys.
# The URL and publishable key are public by design: they are inlined into the bundle at
# build time, and row level security keeps every table closed to them.
NEXT_PUBLIC_SUPABASE_URL="https://[FILL: SUPABASE_PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="[FILL: SUPABASE_PUBLISHABLE_KEY]"
# The secret key (sb_secret_...) is how the server reads and writes the database; it
# bypasses row level security. Server-only: never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="[FILL: SUPABASE_SECRET_KEY]"

# Migrations don't need a variable here: `npx supabase login`, then
# `npx supabase link --project-ref [FILL: SUPABASE_PROJECT_REF]` (docs/deploy/supabase.md).

# ── 2. Admins ────────────────────────────────────────────────────────────────
# Comma-separated. Only these addresses get a sign-in link or can open /admin.
ADMIN_EMAILS="[FILL: ADMIN_EMAIL],[FILL: ANOTHER_ADMIN_EMAIL]"

# ── 3. Site address ──────────────────────────────────────────────────────────
# With https in production. Baked into the build: rebuild after changing it.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── 4. Email (optional) ──────────────────────────────────────────────────────
# The app emails admins about new submissions and tells submitters the admin's decision,
# through Resend. Leave these empty and it sends nothing; each email it would have sent
# is logged instead. The sender must be on a domain verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

# Admin sign-in emails are sent by Supabase, not the app. To send them through Resend,
# add Resend as custom SMTP in the Supabase dashboard (docs/deploy/supabase.md).
