generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── TODA directory ───────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// What a resident sent through /toda/submit. Never shown publicly as-is: an admin
/// verifies it first, and only then is it copied into `Toda`.
model TodaSubmission {
  id                  String   @id @default(cuid())
  name                String
  terminalDescription String
  barangay            String
  lat                 Float?
  lng                 Float?
  barangaysServed     String[]
  units               Int?
  /// Association hotline or office number. Published once verified.
  officialContact     String?
  /// Who sent it. Private: only admins see these two fields.
  submitterName       String?
  submitterContact    String?
  notes               String?

  status          SubmissionStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  /// The directory entry this submission created or updated when it was verified.
  toda            Toda?            @relation(fields: [todaId], references: [id], onDelete: SetNull)
  todaId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("toda_submission")
}

/// The public TODA list. Rows are only written when an admin verifies a submission.
model Toda {
  /// Slug of the name, e.g. "sumacab-este-toda".
  id                  String   @id
  name                String
  terminalDescription String
  barangay            String
  lat                 Float?
  lng                 Float?
  barangaysServed     String[]
  units               Int?
  officialContact     String?
  /// "community" for resident submissions, "official" once the city's list confirms it.
  source              String   @default("community")
  lastVerified        DateTime

  submissions TodaSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("toda")
}

// ── Community jeepney routes ─────────────────────────────────────────────────

enum JeepType {
  TRADITIONAL
  MODERN
  UNKNOWN
}

/// What a resident sent through /fare/suggest: a route from point A to point B.
/// Never shown publicly as-is: an admin verifies it first, and only then is the
/// road line fetched and copied into `CommunityJeepRoute`.
model RouteSubmission {
  id               String   @id @default(cuid())
  /// e.g. "Cabanatuan – Talavera"
  name             String
  fromName         String
  fromLat          Float
  fromLng          Float
  toName           String
  toLat            Float
  toLng            Float
  /// Towns or roads in between, free text.
  via              String?
  jeepType         JeepType @default(UNKNOWN)
  /// Centavos, end to end, as the rider paid.
  farePaid         Int?
  /// Who sent it. Private: only admins see these two fields.
  submitterName    String?
  submitterContact String?
  notes            String?

  status          SubmissionStatus    @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedBy      User?               @relation("RouteReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  /// The public route this submission created or updated when it was verified.
  route           CommunityJeepRoute? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  routeId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@map("route_submission")
}

/// Public routes shown on the fare map next to the presets. Rows are only written
/// when an admin verifies a submission.
model CommunityJeepRoute {
  /// Slug of the name, e.g. "cabanatuan-talavera".
  id         String   @id
  name       String
  fromName   String
  toName     String
  via        String?
  jeepType   JeepType
  /// [[lng, lat], ...] road line from A to B, fetched from OSRM on approval.
  line       Json
  distanceKm Float
  /// Centavos.
  farePaid   Int?
  verifiedOn DateTime

  submissions RouteSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("community_jeep_route")
}

// ── Better Auth (admin magic-link sign-in) ───────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  reviewedSubmissions      TodaSubmission[]
  reviewedRouteSubmissions RouteSubmission[] @relation("RouteReviews")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
